<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
    xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Custom Footer"
    sling:resourceType="cq/gui/components/authoring/dialog">

    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">

        <items
            jcr:primaryType="nt:unstructured">

            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs">

                <items
                    jcr:primaryType="nt:unstructured">

                    <general
                        jcr:primaryType="nt:unstructured"
                        jcr:title="General"
                        sling:resourceType="granite/ui/components/coral/foundation/container">

                        <items
                            jcr:primaryType="nt:unstructured">

                            <!-- Logo -->

                            <logo
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Logo"
                                name="./logo"
                                rootPath="/content/dam" />


                            <!-- Logo Alt Text -->

                            <logoAlt
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Logo Alt Text"
                                name="./logoAlt" />


                            <!-- Copyright -->

                            <copyright
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Copyright"
                                name="./copyright" />


                            <!-- Region -->

                            <region
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Region"
                                name="./region" />


                            <!-- Newsletter -->

                            <newsletterUrl
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Newsletter URL"
                                name="./newsletterUrl" />


                            <!-- Facebook -->

                            <facebookUrl
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Facebook URL"
                                name="./facebookUrl" />


                            <!-- Instagram -->

                            <instagramUrl
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Instagram URL"
                                name="./instagramUrl" />


                            <!-- YouTube -->

                            <youtubeUrl
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="YouTube URL"
                                name="./youtubeUrl" />


                            <!-- LinkedIn -->

                            <linkedinUrl
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="LinkedIn URL"
                                name="./linkedinUrl" />

                        </items>

                    </general>


                    <company
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Company Information"
                        sling:resourceType="granite/ui/components/coral/foundation/container">

                        <items
                            jcr:primaryType="nt:unstructured">


                            <!-- Section Title -->

                            <companyTitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Section Title"
                                name="./companyTitle" />


                            <!-- Company Links -->

                            <companyLinks
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                fieldLabel="Company Links"
                                composite="{Boolean}true">

                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./companyLinks">

                                    <items
                                        jcr:primaryType="nt:unstructured">


                                        <!-- Link Text -->

                                        <label
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Link Text"
                                            name="./label" />


                                        <!-- Link URL -->

                                        <url
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldLabel="Link URL"
                                            name="./url"
                                            rootPath="/content" />

                                    </items>

                                </field>

                            </companyLinks>

                        </items>

                    </company>

                    <news
                        jcr:primaryType="nt:unstructured"
                        jcr:title="News and Events"
                        sling:resourceType="granite/ui/components/coral/foundation/container">

                        <items
                            jcr:primaryType="nt:unstructured">


                            <!-- Section Title -->

                            <newsTitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Section Title"
                                name="./newsTitle" />


                            <!-- News Links -->

                            <newsLinks
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                fieldLabel="News Links"
                                composite="{Boolean}true">

                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./newsLinks">

                                    <items
                                        jcr:primaryType="nt:unstructured">


                                        <!-- Link Text -->

                                        <label
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Link Text"
                                            name="./label" />


                                        <!-- Link URL -->

                                        <url
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldLabel="Link URL"
                                            name="./url"
                                            rootPath="/content" />

                                    </items>

                                </field>

                            </newsLinks>

                        </items>

                    </news>

                    <popular
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Popular Links"
                        sling:resourceType="granite/ui/components/coral/foundation/container">

                        <items
                            jcr:primaryType="nt:unstructured">


                            <!-- Section Title -->

                            <popularTitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Section Title"
                                name="./popularTitle" />


                            <!-- Popular Links -->

                            <popularLinks
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                fieldLabel="Popular Links"
                                composite="{Boolean}true">

                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./popularLinks">

                                    <items
                                        jcr:primaryType="nt:unstructured">


                                        <!-- Link Text -->

                                        <label
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Link Text"
                                            name="./label" />


                                        <!-- Link URL -->

                                        <url
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldLabel="Link URL"
                                            name="./url"
                                            rootPath="/content" />

                                    </items>

                                </field>

                            </popularLinks>

                        </items>

                    </popular>

                    <legal
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Legal Links"
                        sling:resourceType="granite/ui/components/coral/foundation/container">

                        <items
                            jcr:primaryType="nt:unstructured">


                            <!-- Privacy Policy -->

                            <privacyUrl
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Privacy Policy"
                                name="./privacyUrl"
                                rootPath="/content" />


                            <!-- Your Privacy Choices -->

                            <privacyChoicesUrl
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Your Privacy Choices"
                                name="./privacyChoicesUrl"
                                rootPath="/content" />


                            <!-- Legal -->

                            <legalUrl
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Legal"
                                name="./legalUrl"
                                rootPath="/content" />


                            <!-- Accessibility -->

                            <accessibilityUrl
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Accessibility"
                                name="./accessibilityUrl"
                                rootPath="/content" />


                            <!-- Corporate Policies -->

                            <policiesUrl
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Corporate Policies"
                                name="./policiesUrl"
                                rootPath="/content" />


                            <!-- Product Security -->

                            <securityUrl
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Product Security"
                                name="./securityUrl"
                                rootPath="/content" />


                            <!-- Contact -->

                            <contactUrl
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Contact"
                                name="./contactUrl"
                                rootPath="/content" />

                        </items>

                    </legal>

                </items>

            </tabs>

        </items>

    </content>

</jcr:root>