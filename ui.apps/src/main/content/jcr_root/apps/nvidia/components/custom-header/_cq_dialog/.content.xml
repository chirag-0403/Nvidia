<?xml version="1.0" encoding="UTF-8"?>

<jcr:root
    xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Custom Footer"
    sling:resourceType="cq/gui/components/authoring/dialog">

    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">

        <items jcr:primaryType="nt:unstructured">

            <!-- ================================================= -->
            <!-- LOGO -->
            <!-- ================================================= -->

            <logo
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                fieldLabel="Logo"
                name="./logo"
                rootPath="/content/dam"/>

            <logoLink
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                fieldLabel="Logo Link"
                name="./logoLink"
                rootPath="/content"/>


            <!-- ================================================= -->
            <!-- PRODUCTS -->
            <!-- ================================================= -->

            <products
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/fieldset"
                jcr:title="Products">

                <items jcr:primaryType="nt:unstructured">

                    <productsLabel
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Label"
                        name="./productsLabel"
                        value="Products"/>

                    <productsLink
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Link"
                        name="./productsLink"
                        rootPath="/content"/>

                    <productsMegaMenu
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                        fieldLabel="Mega Menu Items"
                        composite="{Boolean}true">

                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            name="./productsMegaMenu">

                            <items jcr:primaryType="nt:unstructured">

                                <title
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Title"
                                    name="./title"/>

                                <description
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                    fieldLabel="Description"
                                    name="./description"/>

                                <link
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldLabel="Link"
                                    name="./link"
                                    rootPath="/content"/>

                            </items>

                        </field>

                    </productsMegaMenu>

                </items>

            </products>


            <!-- ================================================= -->
            <!-- SOLUTIONS -->
            <!-- ================================================= -->

            <solutions
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/fieldset"
                jcr:title="Solutions">

                <items jcr:primaryType="nt:unstructured">

                    <solutionsLabel
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Label"
                        name="./solutionsLabel"
                        value="Solutions"/>

                    <solutionsLink
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Link"
                        name="./solutionsLink"
                        rootPath="/content"/>

                    <solutionsMegaMenu
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                        fieldLabel="Mega Menu Items"
                        composite="{Boolean}true">

                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            name="./solutionsMegaMenu">

                            <items jcr:primaryType="nt:unstructured">

                                <title
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Title"
                                    name="./title"/>

                                <description
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                    fieldLabel="Description"
                                    name="./description"/>

                                <link
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldLabel="Link"
                                    name="./link"
                                    rootPath="/content"/>

                            </items>

                        </field>

                    </solutionsMegaMenu>

                </items>

            </solutions>


            <!-- ================================================= -->
            <!-- INDUSTRIES -->
            <!-- ================================================= -->

            <industries
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/fieldset"
                jcr:title="Industries">

                <items jcr:primaryType="nt:unstructured">

                    <industriesLabel
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Label"
                        name="./industriesLabel"
                        value="Industries"/>

                    <industriesLink
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Link"
                        name="./industriesLink"
                        rootPath="/content"/>

                    <industriesMegaMenu
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                        fieldLabel="Mega Menu Items"
                        composite="{Boolean}true">

                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            name="./industriesMegaMenu">

                            <items jcr:primaryType="nt:unstructured">

                                <title
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Title"
                                    name="./title"/>

                                <description
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                    fieldLabel="Description"
                                    name="./description"/>

                                <link
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldLabel="Link"
                                    name="./link"
                                    rootPath="/content"/>

                            </items>

                        </field>

                    </industriesMegaMenu>

                </items>

            </industries>


            <!-- ================================================= -->
            <!-- SHOP -->
            <!-- ================================================= -->

            <shop
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/fieldset"
                jcr:title="Shop">

                <items jcr:primaryType="nt:unstructured">

                    <shopLabel
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Label"
                        name="./shopLabel"
                        value="Shop"/>

                    <shopLink
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Link"
                        name="./shopLink"
                        rootPath="/content"/>

                </items>

            </shop>


            <!-- ================================================= -->
            <!-- DRIVERS -->
            <!-- ================================================= -->

            <drivers
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/fieldset"
                jcr:title="Drivers">

                <items jcr:primaryType="nt:unstructured">

                    <driversLabel
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Label"
                        name="./driversLabel"
                        value="Drivers"/>

                    <driversLink
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Link"
                        name="./driversLink"
                        rootPath="/content"/>

                </items>

            </drivers>


            <!-- ================================================= -->
            <!-- SUPPORT -->
            <!-- ================================================= -->

            <support
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/fieldset"
                jcr:title="Support">

                <items jcr:primaryType="nt:unstructured">

                    <supportLabel
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Label"
                        name="./supportLabel"
                        value="Support"/>

                    <supportLink
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Link"
                        name="./supportLink"
                        rootPath="/content"/>

                </items>

            </support>


            <!-- ================================================= -->
            <!-- SEARCH -->
            <!-- ================================================= -->

            <showSearch
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                fieldLabel="Search"
                text="Show Search"
                name="./showSearch"
                value="true"
                checked="{Boolean}true"
                uncheckedValue="false"/>

            <searchLink
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                fieldLabel="Search Link"
                name="./searchLink"
                rootPath="/content"/>


            <!-- ================================================= -->
            <!-- LANGUAGE -->
            <!-- ================================================= -->

            <showLanguage
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                fieldLabel="Language"
                text="Show Language"
                name="./showLanguage"
                value="true"
                checked="{Boolean}true"
                uncheckedValue="false"/>

            <languageLink
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                fieldLabel="Language Link"
                name="./languageLink"
                rootPath="/content"/>


            <!-- ================================================= -->
            <!-- SIGN IN -->
            <!-- ================================================= -->

            <showSignIn
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                fieldLabel="Sign In"
                text="Show Sign In"
                name="./showSignIn"
                value="true"
                checked="{Boolean}true"
                uncheckedValue="false"/>

            <signInLink
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                fieldLabel="Sign In Link"
                name="./signInLink"
                rootPath="/content"/>

        </items>

    </content>

</jcr:root>